# 이 파일을 복사해서 이름을 .env 로 바꾸고, 내 MySQL 정보로 채우세요.
# (.env 는 비밀번호가 들어 있으니 깃허브에 올리지 마세요!)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=여기에_MySQL_비밀번호
DB_NAME=life_game

# 메일 보내기 (인증번호 · 아이디 찾기). 비워 두면 메일 대신 서버 창에 내용이 찍혀요.
# Gmail 예시 : 구글 계정 → 보안 → 2단계 인증 켜기 → 앱 비밀번호 만들기
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
